# Prototype 3 uses the local Ollama server. These defaults match the tested setup.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# P5 currently pins all local work to qwen3:4b-instruct.
# Legacy analyzer/planner model overrides are ignored.
P5_FAST_TIMEOUT_MS=180000
# Optional persistent signing key for deployments; leave blank locally.
P5_COMPILATION_SECRET=
# P6 uses Gemini when selected. Keep the real key in .env.local or the host's
# encrypted environment settings; never commit it.
P6_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# P6 keeps design work bounded and signs every accepted artifact.
P6_DESIGN_TIMEOUT_MS=480000
P6_COMPILATION_SECRET=
